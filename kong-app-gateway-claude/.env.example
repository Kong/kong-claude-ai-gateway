# Copy to .env (git-ignored) and fill in real values. .env itself is never
# read by kongctl or committed — it's the source you seed into the Konnect
# vault from (see README.md, Step 3). kongctl only ever sees
# {vault://claude-gateway-vault/<key>} references in the *.yaml files here.

# Konnect Personal Access Token kongctl authenticates with.
KONGCTL_DEFAULT_KONNECT_PAT=

# Claude credentials (Step 2 — Claude integration)
ANTHROPIC_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Okta OIDC app (Step 4 — SSO). Bring your own tenant/app; see README.md.
OKTA_ISSUER=
OKTA_CLIENT_ID=
OKTA_CLIENT_SECRET=
OIDC_CACHE_TOKENS_SALT=
