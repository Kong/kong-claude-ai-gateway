# Copy to .env and fill in real values. .env is git-ignored — never commit it.
#
# Every value here ends up in one of two places:
#   - KONNECT_*: read directly by kongctl (as KONGCTL_DEFAULT_KONNECT_PAT/
#     --region) to create/manage the AI Gateway 2.0 control plane itself.
#   - everything else: seeded into the Konnect vault (claude-gateway-vault)
#     by scripts/bootstrap-vault.sh, then referenced from the *.yaml files
#     as {vault://claude-gateway-vault/<key>} — never inlined as a literal.

# --- Konnect ---
# Personal Access Token: Konnect UI -> profile menu -> Personal access tokens
# -> Generate. kongctl reads this as KONGCTL_DEFAULT_KONNECT_PAT.
KONNECT_TOKEN=
# Region your org lives in (us, eu, au, ...) -> selects the kongctl base URL.
KONNECT_REGION=us
# Display name for the AI Gateway 2.0 control plane this repo creates
# (see 1-gateway.yaml). Free text, not a Konnect-assigned ID — quote it,
# this file gets `source`d directly and the default has a space in it.
KONNECT_CONTROL_PLANE="Claude Gateway"

# --- Anthropic ---
ANTHROPIC_API_KEY=
# Header name the Anthropic model provider sends the key on. Only change
# this if you're proxying to something other than Anthropic's real API.
ANTHROPIC_API_KEY_HEADER=x-api-key

# --- Okta (SSO, see 3-identity-provider.yaml) ---
# Bring your own Okta tenant + app; see README.md Step 4 for setup.
OKTA_ISSUER=
OKTA_CLIENT_ID=
OKTA_CLIENT_SECRET=
# Salt for the OIDC plugin's token cache keys. Any long random string —
# generate with `openssl rand -hex 32`. Must be explicit and stable across
# restarts (a changing salt invalidates cached tokens).
OIDC_CACHE_TOKENS_SALT=

# --- Group-based entitlement (see 3-identity-provider.yaml, 6-*, 7-*) ---
# The Okta access-token claim carrying group membership, and the values
# this repo expects on it (kong-premium / kong-standard). Documentation of
# intent only — 6-per-group-model-listing.yaml's Lua and the
# consumer_groups_claim API call both hardcode "team" directly (kongctl
# doesn't expand ${{ env "..." }} tags), so changing this value alone does
# NOT change gateway behavior. Change the hardcoded "team" string in both
# places if your claim is named differently.
TEAM_CLAIM_NAME=team
