# --- AI Gateway 2.0 control plane (kongctl) ---
KONGCTL_DEFAULT_KONNECT_PAT=

# AI Gateway 2.0 currently lives on a separate Konnect environment from the
# 1.x track (.tech, not .com). Only set this if your org uses a different
# region/environment than the default baked into
# scripts/00-bootstrap-konnect-2.0.sh.
KONNECT_AIGW2_BASE_URL=

# Filled in by scripts/00-bootstrap-konnect-2.0.sh after it creates/verifies
# the control plane. Used by docker-compose.aigw2.yml to point the data
# plane at Konnect.
KONNECT_AIGW2_CP_ENDPOINT=
KONNECT_AIGW2_TELEMETRY_ENDPOINT=

# Local path prefix for the 2.0 data plane's client cert/key (tls.crt,
# tls.key) — mounted read-only by docker-compose.aigw2.yml. Kept separate
# from the 1.x track's ./certs so both stacks can run at once.
CERTS_DIR_2_0=./certs-2.0

# --- AI Gateway 2.0 vault (holds provider credentials; never put real
# values in kong-2.0/*.yaml — see docs-2.0/00-prerequisites-2.0.md).
# scripts/00-bootstrap-konnect-2.0.sh reads these once, locally, to seed
# the "ai-vault" config store's secrets. Not read by Kong at runtime (Kong
# reads them from the vault via {vault://ai-vault/<key>} references). ---
ANTHROPIC_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# --- Module 2 (key auth) ---
# The key-auth credential value for the "claude-desktop" AI Gateway
# consumer. Unlike the 1.x track's DECK_CONSUMER_API_KEY, `kongctl apply`
# CANNOT set this value declaratively — the Konnect API auto-generates a
# credential's key server-side, and kongctl's declarative
# ai_gateways.consumers.credentials schema has no field to override it
# (confirmed via `kongctl explain ai_gateways.consumers.credentials
# --extended`). This var is a placeholder for a future Docker-enabled run:
# to get a *known* testable value, create the credential directly against
# the Konnect API (not via kongctl) with this value as `api_key` — see
# docs-2.0/02-key-auth-2.0.md's "vs. the brief" section for the exact
# curl command. Generate with `openssl rand -hex 24`.
KONGCTL_CONSUMER_API_KEY=

# Modules 3-7 add their own vars here as they're built (see the
# corresponding docs-2.0/NN-*.md).
