# --- AI Gateway 2.0 control plane (kongctl) ---
KONGCTL_DEFAULT_KONNECT_PAT=

# AI Gateway 2.0 currently lives on a separate Konnect environment from the
# 1.x track (.tech, not .com). Only set this if your org uses a different
# region/environment than the default baked into
# scripts/00-bootstrap-konnect-2.0.sh.
KONNECT_AIGW2_BASE_URL=

# Filled in by scripts/00-bootstrap-konnect-2.0.sh after it creates/verifies
# the control plane. Used by docker-compose.aigw2.yml to point the data
# plane at Konnect.
KONNECT_AIGW2_CP_ENDPOINT=
KONNECT_AIGW2_TELEMETRY_ENDPOINT=

# Local path prefix for the 2.0 data plane's client cert/key (tls.crt,
# tls.key) — mounted read-only by docker-compose.aigw2.yml. Kept separate
# from the 1.x track's ./certs so both stacks can run at once.
CERTS_DIR_2_0=./certs-2.0

# --- AI Gateway 2.0 vault (holds provider credentials; never put real
# values in kong-2.0/*.yaml — see docs-2.0/00-prerequisites-2.0.md).
# scripts/00-bootstrap-konnect-2.0.sh reads these once, locally, to seed
# the "ai-vault" config store's secrets. Not read by Kong at runtime (Kong
# reads them from the vault via {vault://ai-vault/<key>} references). ---
ANTHROPIC_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# --- Module 2 (key auth) ---
# The key-auth credential value for the "claude-desktop" AI Gateway
# consumer. Unlike the 1.x track's DECK_CONSUMER_API_KEY, `kongctl apply`
# CANNOT set this value declaratively — the Konnect API auto-generates a
# credential's key server-side, and kongctl's declarative
# ai_gateways.consumers.credentials schema has no field to override it
# (confirmed via `kongctl explain ai_gateways.consumers.credentials
# --extended`). This var is a placeholder for a future Docker-enabled run:
# to get a *known* testable value, create the credential directly against
# the Konnect API (not via kongctl) with this value as `api_key` — see
# docs-2.0/02-key-auth-2.0.md's "vs. the brief" section for the exact
# curl command. Generate with `openssl rand -hex 24`.
KONGCTL_CONSUMER_API_KEY=

# --- Module 3 (OIDC + Okta) ---
# Same Okta app as `docs/okta-setup.md` (1.x track) — no new Okta app
# needed if you already did that setup. See docs-2.0/03-oidc-okta-2.0.md
# for what's different about this track's redirect URI (offset port 8010,
# not 8000).
#
# UNLIKE modules 1/2's vars, these do NOT get consumed by `kongctl apply`
# via `${{ env "..." }}` tags the way the 1.x/decK track's
# `kong/03-oidc-okta.yaml` does — confirmed live that kongctl does not
# support that tag syntax at all (it passes the literal string through
# unexpanded; see kong-2.0/03-oidc-okta.yaml's header comment for the
# live repro). Instead, `kong-2.0/03-oidc-okta.yaml` references these as
# `{vault://ai-vault/<key>}`, the same mechanism modules 1/2 use for the
# Anthropic/AWS secrets. `scripts/00-bootstrap-konnect-2.0.sh` seeds these
# into the `ai-vault` config store automatically, the same way it already
# seeds ANTHROPIC_API_KEY/AWS_* — just set the vars below and re-run it.
KONGCTL_OKTA_ISSUER=
KONGCTL_OKTA_CLIENT_ID=
KONGCTL_OKTA_CLIENT_SECRET=
KONGCTL_OIDC_CACHE_TOKENS_SALT=

# Real Okta access token (not tied to a specific team/claim) used by
# scripts/verify-2.0.sh's `03-oidc-okta`, `05-consumer-rate-limiting`, and
# `07-opentelemetry` cases. Distinct from OKTA_ACCESS_TOKEN_PREMIUM/
# OKTA_ACCESS_TOKEN_STANDARD below, which are team-claimed tokens used only
# by module 04's case.
OKTA_ACCESS_TOKEN=

# --- Module 4 (per-user model access limits) ---
# Documentation of the brief's original intent only — NOT consumed by
# `kongctl apply`. Per module 3's confirmed finding, `${{ env "..." }}`
# tag substitution does not work with kongctl, and these two values are
# not secrets, so kong-2.0/04-per-user-model-limits.yaml hardcodes
# KONGCTL_TEAM_CLAIM_NAME's value ("team") directly into its pre-function
# policy's Lua instead of templating it. KONGCTL_TEAM_HEADER_NAME is
# unused by this module's actual (single-policy, no header-rewrite)
# design — see docs-2.0/04-per-user-model-limits-2.0.md's "vs. 1.x"
# section for why. Kept here for parity with the brief and as a marker
# for what a future config-store-driven version would seed.
KONGCTL_TEAM_CLAIM_NAME=team
KONGCTL_TEAM_HEADER_NAME=Team

# Used only by scripts/verify-2.0.sh's `04-per-user-model-limits` case
# (future Docker-enabled run) — real Okta access tokens for a
# `kong-premium`-claimed and a `kong-standard`-claimed user/app. Not
# minted or chased down in this task; see
# docs-2.0/04-per-user-model-limits-2.0.md's closing section for why.
OKTA_ACCESS_TOKEN_PREMIUM=
OKTA_ACCESS_TOKEN_STANDARD=

# --- Module 5 (consumer-based rate limiting) ---
# No new vars — scripts/verify-2.0.sh's `05-consumer-rate-limiting` case
# reuses OKTA_ACCESS_TOKEN (see the Module 3 section above).

# Modules 6-7 add their own vars here as they're built (see the
# corresponding docs-2.0/NN-*.md).
