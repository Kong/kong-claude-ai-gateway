# --- Konnect control plane ---
KONNECT_TOKEN=
KONNECT_REGION=us
KONNECT_CONTROL_PLANE=claude-e2e

# Filled in by scripts/00-bootstrap-konnect.sh after it creates/verifies the
# control plane. Used by docker-compose.yml to point the data plane at Konnect.
KONNECT_CP_ENDPOINT=
KONNECT_TELEMETRY_ENDPOINT=

# Local path to the data plane client certificate/key pair (tls.crt, tls.key)
# — see docs/00-prerequisites.md for how to generate one. Mounted read-only
# into the kong-dp container by docker-compose.yml.
CERTS_DIR=./certs

# --- Konnect vault (holds the real Anthropic key; never put the key itself
# in kong/*.yaml or here permanently — see docs/00-prerequisites.md) ---
KONG_VAULT_CONFIG_STORE_ID=

# Used once, locally, by scripts/00-bootstrap-konnect.sh to seed the Konnect
# vault secret "anthropic-secrets/anthropic-api-key". Not read by Kong at
# runtime (Kong reads it from the vault via {vault://...} reference).
ANTHROPIC_API_KEY=
ANTHROPIC_API_KEY_HEADER="x-api-key: <key>"

# --- Module 2 (key auth) ---
# The key-auth credential Kong issues to the Consumer "claude-desktop".
# This is what you put in Claude Desktop's API key field — not the real
# Anthropic key. Generate any random string, e.g. `openssl rand -hex 24`.
KONG_CONSUMER_API_KEY=

# --- Module 3 (OIDC + Okta) — see docs/okta-setup.md ---
# Your Okta app's discovery URL, e.g.
# https://<your-org>.okta.com/oauth2/default/.well-known/openid-configuration
OKTA_ISSUER=
OKTA_CLIENT_ID=
# Native apps (see docs/okta-setup.md) are public clients — Okta won't
# issue a real secret. Kong's openid-connect plugin still requires this
# field non-empty, so put any dummy value in, e.g. "not-used-native-client".
OKTA_CLIENT_SECRET=
# Signs/encrypts the openid-connect plugin's session cookie. Generate with
# `openssl rand -hex 32`.
OIDC_SESSION_SECRET=
# Salt for the plugin's token cache keys. Must be explicit and stable —
# decK refuses to sync without it, since leaving it unset would regenerate
# the salt (and invalidate all active sessions) on every apply. Generate
# with `openssl rand -hex 16`.
OIDC_CACHE_TOKENS_SALT=

# --- Module 4 (per-user model access limits) ---
# JWT claim the pre-function plugin reads (from the Okta access token) and
# the request header it copies that claim into for team-based routing on
# GET /anthropic/v1/models. Change these if your Okta claim is named
# differently.
TEAM_CLAIM_NAME=team
TEAM_HEADER_NAME=Team

# Modules 5-7 (rate limiting, observability, tracing) don't need any new
# vars beyond what's already above. Module 8 (billing/metering) will add
# its own vars here when it's built.
